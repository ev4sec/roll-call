{
  "description": "roll-call: routes each change to the agent that owns it, proves the consult happened, and guards the irreversible. Every hook runs through run.sh, which resolves a Python 3.11+ interpreter and degrades with a readable message when none exists.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session_open",
            "timeout": 10,
            "statusMessage": "Checking roll-call setup and ledgers"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" pre_shell",
            "timeout": 15,
            "statusMessage": "Checking publish policy and agent edits"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" post_edit",
            "timeout": 30,
            "statusMessage": "Routing and scanning the change"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" post_batch",
            "timeout": 600,
            "statusMessage": "Running tests and auditing the batch"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" agent_snapshot",
            "timeout": 15,
            "statusMessage": "Noting the tree before the agent runs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" agent_stop",
            "timeout": 20,
            "statusMessage": "Recording the consult and its claims"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" turn_end",
            "timeout": 20,
            "statusMessage": "Checking for consults still owed"
          }
        ]
      }
    ]
  }
}
